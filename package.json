      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.228",
    "@cursor/sdk": "^1.0.27",
    "@openai/codex-sdk": "^0.147.0",
    "@opentui/core": "^0.5.2",
    "@opentui/react": "^0.5.2",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  }
}
