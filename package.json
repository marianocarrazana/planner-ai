{
  "name": "planner-ai",
  "version": "1.0.0",
  "description": "Terminal UI that turns a goal into a consensus plan across multiple models",
  "type": "module",
  "bin": {
    "planner": "./src/cli.tsx"
  },
  "scripts": {
    "dev": "bun run src/cli.tsx",
    "start": "bun run src/cli.tsx",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "bun",
